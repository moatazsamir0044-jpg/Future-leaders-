# Supabase project the app talks to. Both values are safe to expose in the
# browser bundle — the anon key is protected by Row-Level Security, not secrecy.
# Find them under Project Settings → API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses Row-Level Security, so it must never be prefixed with
# NEXT_PUBLIC_ or referenced from a client component. Only /api/admin/users
# uses it, to invite new accounts. Without it, inviting users is disabled and
# the rest of the app works normally.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
